# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=verifymzansi-public
R2_PRIVATE_BUCKET=verifymzansi-private
R2_PUBLIC_URL=https://media.verifymzansi.co.za

# KYC Document Encryption (POPIA Compliance)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_ENCRYPTION_KEY=

# ID Number Encryption (AES-256-GCM — separate key from KYC)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_ENCRYPTION_KEY=

# HMAC Secret (for ID number deduplication hashing)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=

# IP Hash Secret (required in production — for abuse report IP hashing)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IP_HASH_SECRET=

# Africa's Talking (OTP)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=VERIFYMZANS

# Rate Limiter (optional — Cloudflare Worker)
OTP_RATE_LIMITER_URL=
OTP_RATE_LIMITER_TIMEOUT_MS=2500
# RATE_LIMITER_API_KEY=

# PayFast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# ⚠️ SET TO false IN PRODUCTION
PAYFAST_SANDBOX=true
PAYFAST_NOTIFY_URL=https://verifymzansi.co.za/api/webhooks/payfast

# Resend (Email)
RESEND_API_KEY=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Geocoding (defaults to Nominatim — override for custom provider)
# GEOCODING_API_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=verifymzansi/1.0

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=

# ⚠️ NEVER SET IN PRODUCTION — Dev-only bypasses
# ENABLE_DEV_PAYMENT_BYPASS=true
# ENABLE_MOCK_PAYFAST=true
# DEV_EXPOSE_OTP=true

