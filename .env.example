# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=verifymzansi-public
R2_PRIVATE_BUCKET=verifymzansi-private
R2_PUBLIC_URL=https://media.verifymzansi.com

# KYC Document Encryption (POPIA Compliance)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_ENCRYPTION_KEY=

# KYC Provider
# Local development may use "stub"; production launch mode should use "manual"
# until a signed third-party provider is integrated.
KYC_PROVIDER=stub
# Required only for signed provider callbacks. Not needed for KYC_PROVIDER=manual.
KYC_WEBHOOK_SECRET=

# ID Number Encryption (AES-256-GCM — separate key from KYC)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_ENCRYPTION_KEY=

# HMAC Secret (for ID number deduplication hashing)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=

# IP Hash Secret (required in production — for abuse report IP hashing)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# Africa's Talking (OTP)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
# Sender ID must be pre-approved by Africa's Talking and fit within 12 alphanumeric characters.
AFRICASTALKING_SENDER_ID=verifymzansi

# Rate Limiter (optional — Cloudflare Worker)
OTP_RATE_LIMITER_URL=
OTP_RATE_LIMITER_TIMEOUT_MS=2500
# Set only when OTP_RATE_LIMITER_URL is also configured.
# MUST exactly match the WORKER_API_KEY secret configured on the rate-limiter
# worker, or every call returns 401 and the app silently falls back to
# per-isolate limits.
# RATE_LIMITER_API_KEY=
# Local in-memory fallback limiter (used when OTP_RATE_LIMITER_URL is unset)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=20

# Ozow Hosted Checkout
OZOW_ENV=
OZOW_CLIENT_ID=
OZOW_CLIENT_SECRET=
OZOW_SITE_CODE=
OZOW_WEBHOOK_ID=
# Optional: override payment token scope. Defaults to "payments" for Ozow One API.
OZOW_PAYMENT_OAUTH_SCOPE=payments
# Ozow Card Payments are enabled in the Ozow merchant/site configuration.
# The VerifyMzansi One API request does not send card details or force methods.
# Optional: override the default base URL inferred from OZOW_ENV
# OZOW_API_BASE_URL=https://stagingone.ozow.com
OZOW_WEBHOOK_SECRET=

# Resend (Email)
RESEND_API_KEY=
# Owner lifecycle notifications (new listings, expirations) — enabled by default.
# Set to "false" to disable these messages.
# ENABLE_OWNER_LIFECYCLE_NOTIFICATIONS=true

# Cloudflare Turnstile
# Use the real site/secret pair only on the hostname(s) registered in Cloudflare.
# For localhost or other non-production hosts, prefer dummy_site_key / dummy_secret_key
# or leave the keys unset so the app uses the dev bypass path instead of hard-failing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Geocoding (defaults to Nominatim — override for custom provider)
# GEOCODING_API_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=verifymzansi/1.0

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use your public HTTPS domain in production so confirmation emails open the real login page.
NODE_ENV=development
NEXT_PUBLIC_VERIFYMZANSI_FACEBOOK_URL=
NEXT_PUBLIC_VERIFYMZANSI_YOUTUBE_URL=
NEXT_PUBLIC_VERIFYMZANSI_X_URL=
NEXT_PUBLIC_VERIFYMZANSI_TIKTOK_URL=
NEXT_PUBLIC_VERIFYMZANSI_LINKEDIN_URL=

# Public trust and legal identity disclosures
# Configure only verified, publishable values. Empty fields are hidden publicly.
# Keep branded @verifymzansi.com aliases public. Route inbound mail to Gmail separately.
NEXT_PUBLIC_VERIFYMZANSI_CONTACT_EMAIL=hello@verifymzansi.com
NEXT_PUBLIC_VERIFYMZANSI_HELLO_EMAIL=hello@verifymzansi.com
NEXT_PUBLIC_VERIFYMZANSI_SUPPORT_EMAIL=support@verifymzansi.com
NEXT_PUBLIC_VERIFYMZANSI_PRIVACY_EMAIL=privacy@verifymzansi.com
NEXT_PUBLIC_VERIFYMZANSI_SECURITY_EMAIL=security@verifymzansi.com
VERIFYMZANSI_LEGAL_NAME=
VERIFYMZANSI_TRADING_NAME=
VERIFYMZANSI_CIPC_NUMBER=
VERIFYMZANSI_BUSINESS_ADDRESS=
VERIFYMZANSI_RESPONSIBLE_OFFICER=
VERIFYMZANSI_INFORMATION_OFFICER_NAME=
VERIFYMZANSI_INFORMATION_OFFICER_EMAIL=privacy@verifymzansi.com
VERIFYMZANSI_INFORMATION_OFFICER_PHONE=
VERIFYMZANSI_INFORMATION_OFFICER_WHATSAPP=
VERIFYMZANSI_SUPPORT_EMAIL=support@verifymzansi.com
VERIFYMZANSI_SUPPORT_PHONE=
VERIFYMZANSI_SECURITY_EMAIL=security@verifymzansi.com
VERIFYMZANSI_OZOW_MERCHANT_NAME=
VERIFYMZANSI_VAT_STATUS=

# Media CDN
NEXT_PUBLIC_MEDIA_URL=https://media.verifymzansi.com
# Cloudflare Image Resizing (set "true" once enabled on the zone)
NEXT_PUBLIC_CF_IMAGE_RESIZING=false
# Direct client-to-R2 video uploads via presigned URLs (default: enabled).
# Set to 0 to force the server-validated /api/media/upload endpoint.
# ENABLE_DIRECT_R2_UPLOADS=1

# Startup strictness — set to "1" in production to crash on env validation
# errors instead of serving with degraded config.  See LAUNCH-CHECKLIST.md §8.
# STRICT_ENV_STARTUP_BLOCK=1

# Optional bearer token for the /api/health/storage diagnostics endpoint.
# When unset the endpoint is disabled (404). Do NOT reuse HMAC_SECRET here.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HEALTH_DIAGNOSTIC_TOKEN=

# Companion Cloudflare Workers shared secret (rate-limiter, payment-cleanup,
# retention-cleanup, kyc-encryptor). The main app never reads this variable —
# it is the workers' copy of the shared secret and MUST exactly match the
# main app's RATE_LIMITER_API_KEY, or every rate-limiter call returns 401 and
# the app silently falls back to per-isolate limits.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WORKER_API_KEY=

# Monitoring (optional)
# Minimum log level: debug | info | warn | error
# (default: debug outside production, info in production)
# LOG_LEVEL=info
# Sentry error monitoring (optional — SDK self-disables when not set)
NEXT_PUBLIC_SENTRY_DSN=
# Optional: CLI/API auth for live issue triage and release/source-map checks.
# Read-only triage needs org:read, project:read, and event:read.
# Release/source-map operations also need project:releases and org:read.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ⚠️ NEVER SET IN PRODUCTION — Dev-only bypasses
# Reserved / NOT YET IMPLEMENTED — no runtime code reads this flag today.
# Kept because docs reference it for a future dev-only payment shortcut.
# ENABLE_DEV_PAYMENT_BYPASS=true
# ENABLE_MOCK_OZOW=true
# DEV_EXPOSE_OTP=true
# Allow unsigned KYC webhooks from local dev tools (NEVER set in production)
# ENABLE_DEV_KYC_WEBHOOK_BYPASS=true
# Skip Turnstile CAPTCHA verification with the "dev-turnstile-bypass" token
# when no secret key is configured (NEVER set in production)
# ENABLE_DEV_TURNSTILE_BYPASS=true

# Remove posting-count limits for testing. Set both on hosted environments so UI and API stay aligned.
# ENABLE_TEST_POSTING_BYPASS=true
# NEXT_PUBLIC_ENABLE_TEST_POSTING_BYPASS=true

# Whitelisted test phone numbers — skip SMS, always accept OTP "999999".
# ⚠️ NEVER set in production — startup is hard-blocked when this is present.
# TEST_PHONE_NUMBERS=+27600000001,+27600000002

# E2E / test harness only — NEVER set in production. These force the runtime
# and launch-validation modes for Playwright runs.
# VERIFYMZANSI_RUNTIME_MODE=e2e
# VERIFYMZANSI_VALIDATION_MODE=e2e
