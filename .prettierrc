{
  "semi": true,
  "singleQuote": false,
  "printWidth": 100,
  "tabWidth": 2,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "auto",
  "plugins": [],
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "printWidth": 80,
        "proseWrap": "always"
      }
    },
    {
      "files": [
        "database/foundation/**",
        "docs/backend-foundation/prototypes/**",
        "docs/backend-foundation/tools/**",
        "src/lib/foundation/**",
        "src/lib/domains/**",
        "scripts/*foundation*",
        "scripts/lib/*foundation*",
        "src/lib/supabase/fetch-with-timeout.ts",
        "src/lib/utils/sa-id-validation.ts",
        "src/lib/constants/verification.ts",
        "src/types/enums.ts"
      ],
      "options": {
        "endOfLine": "lf"
      }
    }
  ]
}
