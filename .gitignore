# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
/package-lock.json

# testing
/coverage
/playwright-report
/test-results
/e2e/.auth/
/.lighthouseci/

# next.js
/.next/
/.open-next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.git.broken-backup-*/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment secrets ──────────────────────────────────────
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
test_output.txt
cloudflare-env-vars.txt

# ── Auto-generated types ─────────────────────────────────────
src/lib/api/v1.d.ts
!src/lib/api/v1.d.ts

# lint reports
eslint_*.txt
eslint_*.json
lint_*.txt
lint_*.json
warnings_detail.txt

# ── Documentation (exclude most .md except allowlisted operator docs) ────
docs/
!docs/
docs/*
!docs/openapi.json
*.md
!README.md
!CONTRIBUTING.md
!CHANGELOG.md
!HARDENING-PLAN.md
!LAUNCH-CHECKLIST.md
!LAUNCH-HARDENING-PLAN.md
!.github/**/*.md
!docs/RUNBOOK.md
!docs/playbooks/
!docs/playbooks/sentry-bug-finding.md

# ── QA evidence & temporary files ─────────────────────────────
/evidence/
/tmp/

