{
  "name": "verifymzansi",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=20.0.0 <26.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build --webpack",
    "capture:live-site": "tsx scripts/capture-live-site.ts",
    "assets:refresh:live": "tsx scripts/generate-live-assets.ts",
    "media:refresh:live": "pnpm capture:live-site && pnpm assets:refresh:live",
    "video:studio": "remotion studio remotion/index.ts",
    "video:render": "remotion render remotion/index.ts VerifyMzansiAdvert output/verifymzansi-advert.mp4",
    "video:still": "remotion still remotion/index.ts VerifyMzansiAdvert output/verifymzansi-advert-poster.png --frame=390",
    "video:render:launch": "remotion render remotion/index.ts VerifyMzansiLaunchReveal output/verifymzansi-launch-reveal.mp4",
    "video:render:how": "remotion render remotion/index.ts VerifyMzansiHowItWorks output/verifymzansi-how-it-works.mp4",
    "video:render:promo": "remotion render remotion/index.ts VerifyMzansiPublicPromo output/verifymzansi-public-promo.mp4",
    "video:still:launch": "remotion still remotion/index.ts VerifyMzansiLaunchReveal output/verifymzansi-launch-reveal-poster.png --frame=390",
    "video:still:how": "remotion still remotion/index.ts VerifyMzansiHowItWorks output/verifymzansi-how-it-works-poster.png --frame=390",
    "video:still:promo": "remotion still remotion/index.ts VerifyMzansiPublicPromo output/verifymzansi-public-promo-poster.png --frame=390",
    "brand:assets": "node scripts/generate-brand-assets.js && node scripts/generate-final-icons.js",
    "build:cloudflare": "node scripts/preflight-cloudflare.js && pnpm exec opennextjs-cloudflare build && pnpm secret-scan:strict && node scripts/patch-opennext-og-paths.js",
    "preview:cloudflare": "node scripts/preflight-cloudflare.js && pnpm exec opennextjs-cloudflare build && pnpm secret-scan:strict && pnpm exec wrangler dev",
    "deploy": "pnpm validate:launch-env && pnpm build:cloudflare && pnpm exec opennextjs-cloudflare deploy --env production",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "pnpm exec eslint src",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.typecheck.json",
    "format": "pnpm exec prettier --write \"src/**/*.{ts,tsx,json,css}\" \"*.{js,json,md}\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.{ts,tsx,json,css}\" \"*.{js,json,md}\"",
    "storybook": "pnpm exec storybook dev -p 6006",
    "storybook:build": "pnpm exec storybook build -o storybook-static",
    "knip": "pnpm exec knip --config knip.jsonc --tsConfig tsconfig.typecheck.json --reporter compact",
    "jscpd": "pnpm exec jscpd --config .jscpd.json src",
    "jscpd:check": "pnpm run jscpd && tsx scripts/check-jscpd-budget.ts",
    "depcruise": "pnpm exec depcruise --config .dependency-cruiser.cjs src",
    "security:audit": "tsx scripts/security-audit.ts",
    "payments:audit": "tsx scripts/payment-security-audit.ts",
    "licenses:check": "tsx scripts/check-licenses.ts",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "secret-scan:strict": "tsx scripts/secret-scan.ts --strict",
    "test": "pnpm test:blocking",
    "test:blocking": "tsx scripts/run-vitest.ts blocking",
    "stability:check": "pnpm lint --max-warnings=0 && pnpm typecheck && pnpm test:smoke && pnpm test:blocking && pnpm build && pnpm audit --prod",
    "test:all": "pnpm test:blocking && pnpm test:coverage:core && pnpm exec playwright test",
    "test:deep": "pnpm test:coverage:core && pnpm exec playwright test",
    "test:coverage": "pnpm test:coverage:core",
    "test:coverage:core": "tsx scripts/run-vitest.ts coverage-core",
    "test:dev-startup": "tsx scripts/dev-startup-smoke.ts",
    "test:launch:flows": "pnpm exec vitest run src/app/api/billing/create-checkout/route.test.ts src/app/api/billing/change-plan/route.test.ts src/app/api/billing/cancel/route.test.ts src/app/api/billing/payment-status/route.test.ts src/lib/payments/checkout.test.ts src/lib/payments/fulfillment.test.ts src/lib/payments/ozow.test.ts src/__tests__/payment-cleanup-worker.test.ts src/app/api/otp/otp.test.ts src/app/verification/page.test.tsx src/__tests__/otp-send-safe-errors.test.ts src/__tests__/otp-exposure.test.ts src/__tests__/dsar-submit-route.test.ts src/__tests__/dsar-validation.test.ts src/app/api/admin/dsar/export/route.test.ts src/app/api/admin/dsar/decide/route.test.ts src/app/api/admin/dsar/complete/route.test.ts src/app/dsar/page.test.tsx && pnpm exec playwright test e2e/billing-payment-roundtrip.spec.ts e2e/dsar.spec.ts --project=chromium",
    "test:smoke": "tsx scripts/test-smoke.ts",
    "test:contract": "tsx scripts/test-contract.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test:perf": "tsx scripts/test-perf.ts",
    "test:perf:k6": "tsx scripts/run-k6.ts",
    "test:mutation": "tsx scripts/test-mutation.ts",
    "safety:review": "tsx scripts/run-safety-gate.ts review",
    "safety:ci-review": "tsx scripts/run-safety-gate.ts ci-review",
    "safety:release": "tsx scripts/run-safety-gate.ts release",
    "check:bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "test:e2e": "pnpm exec playwright test",
    "test:public-verify": "tsx scripts/verify-public-pages.ts",
    "test:live-pages": "tsx scripts/verify-live-pages.ts",
    "security:audit:live-load": "tsx scripts/audit-live-load.ts",
    "security:audit:live-load:strict": "tsx scripts/audit-live-load.ts --strict",
    "bootstrap:operator": "tsx scripts/bootstrap-operator.ts",
    "reset:launch-data": "tsx scripts/reset-launch-data.ts",
    "supabase:cli": "tsx scripts/run-supabase-cli.ts",
    "supabase:migration:list": "tsx scripts/run-supabase-cli.ts migration list",
    "supabase:db:push": "tsx scripts/run-supabase-cli.ts db push",
    "supabase:db:backup": "tsx scripts/backup-supabase.ts",
    "supabase:db:push:safe": "pnpm supabase:db:backup && pnpm supabase:db:push",
    "supabase:advisor:security": "tsx scripts/check-supabase-security-advisor.ts",
    "supabase:advisor:security:strict": "tsx scripts/check-supabase-security-advisor.ts --strict",
    "supabase:advisor:performance": "tsx scripts/check-supabase-performance-advisor.ts",
    "supabase:advisor:performance:strict": "tsx scripts/check-supabase-performance-advisor.ts --strict",
    "db:verify-schema": "tsx scripts/check-supabase-schema.ts",
    "db:check-invariants": "tsx scripts/check-db-invariants.ts",
    "preflight": "tsx scripts/check-node-version.ts && tsx scripts/preflight-check.ts",
    "preflight:prod": "tsx scripts/check-node-version.ts && tsx scripts/preflight-check.ts --mode=production",
    "preflight:prod:edge": "pnpm preflight:prod && pnpm cloudflare:secrets:check && pnpm cloudflare:posture:strict",
    "cloudflare:secrets:check": "node scripts/cloudflare-worker-secrets-check.mjs",
    "cloudflare:secrets:check:staging": "node scripts/cloudflare-worker-secrets-check.mjs --env=staging",
    "cloudflare:posture": "node scripts/cloudflare-posture-check.mjs",
    "cloudflare:posture:strict": "node scripts/cloudflare-posture-check.mjs --strict",
    "cloudflare:posture:strict:zone": "node scripts/cloudflare-posture-check.mjs --strict \"--strict-checks=Health endpoint,HSTS,DNSSEC DS record,www hostname behavior\"",
    "cloudflare:posture:json": "node scripts/cloudflare-posture-check.mjs --json",
    "cloudflare:email-routing:catch-all": "node scripts/cloudflare-email-routing-catch-all.mjs",
    "email:domain:check": "node scripts/email-domain-readiness-check.mjs",
    "cloudflare:zone:remediate": "node scripts/cloudflare-zone-remediate.mjs",
    "validate:launch-env": "tsx scripts/validate-launch-env.ts --mode=production",
    "ozow:webhook:secret": "node scripts/fetch-ozow-webhook-secret.mjs",
    "prepare": "husky",
    "generate:api-types": "pnpm exec openapi-typescript docs/openapi.json -o src/lib/api/v1.d.ts && pnpm exec prettier --write src/lib/api/v1.d.ts",
    "quality:openapi-drift": "tsx scripts/check-openapi-drift.ts",
    "quality:lighthouse": "lhci autorun --config=.lighthouserc.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1018.0",
    "@aws-sdk/s3-request-presigner": "^3.1018.0",
    "@ffmpeg/ffmpeg": "^0.12",
    "@ffmpeg/util": "^0.12",
    "@hookform/resolvers": "^5.2.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.574.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "svix": "^1.92.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@lhci/cli": "^0.15.1",
    "@next/env": "16.2.11",
    "@opennextjs/cloudflare": "^1.19.1",
    "@playwright/test": "^1.59.1",
    "@remotion/cli": "^4.0.448",
    "@storybook/react": "^10.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.5.0",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.2.11",
    "husky": "^9.1.7",
    "jimp": "0.22.10",
    "jscpd": "^5.0.14",
    "jsdom": "^28.1.0",
    "knip": "^6.6.1",
    "lint-staged": "^16.4.0",
    "only-allow": "^1.2.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.59.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.23",
    "prettier": "^3.8.3",
    "remotion": "^4.0.448",
    "supabase": "2.114.0",
    "tailwindcss": "3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.83.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ],
    "overrides": {
      "tailwindcss": "3.4.19",
      "fast-uri": "3.1.5",
      "fast-xml-builder": "1.2.0",
      "fast-xml-parser": ">=5.7.0",
      "postcss": "8.5.23",
      "brace-expansion@^5.0.0": "5.0.9",
      "nanoid": "3.3.18",
      "next>sharp": "$sharp",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "resend>svix": "1.92.2",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  },
  "overrides": {
    "tailwindcss": "3.4.19",
    "@aws-sdk/xml-builder": "^3.972.5",
    "fast-uri": "3.1.5",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": ">=5.7.0",
    "postcss": "$postcss",
    "brace-expansion@^5.0.0": "5.0.9",
    "nanoid": "3.3.18",
    "next": {
      "sharp": "$sharp"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm exec prettier --write",
      "pnpm exec eslint --fix --max-warnings=0"
    ],
    "*.{json,css,md}": [
      "pnpm exec prettier --write"
    ]
  }
}
