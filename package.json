{
  "name": "verifymzansi",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=20.0.0 <26.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "build": "next build --webpack",
    "brand:assets": "node scripts/generate-brand-assets.js && node scripts/generate-final-icons.js",
    "build:cloudflare": "node scripts/preflight-cloudflare.js && pnpm exec opennextjs-cloudflare build && node scripts/patch-opennext-og-paths.js",
    "preview:cloudflare": "node scripts/preflight-cloudflare.js && pnpm exec opennextjs-cloudflare build && pnpm exec wrangler dev",
    "deploy": "pnpm validate:launch-env && node scripts/preflight-cloudflare.js && pnpm exec opennextjs-cloudflare build && pnpm exec opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"*.{js,json,md}\"",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "security:audit": "tsx scripts/security-audit.ts",
    "payments:audit": "tsx scripts/payment-security-audit.ts",
    "licenses:check": "tsx scripts/check-licenses.ts",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "secret-scan:strict": "tsx scripts/secret-scan.ts --strict",
    "test": "pnpm test:blocking",
    "test:blocking": "tsx scripts/run-vitest.ts blocking",
    "test:all": "pnpm test:blocking && pnpm test:coverage:core && playwright test",
    "test:deep": "pnpm test:coverage:core && playwright test",
    "test:coverage": "pnpm test:coverage:core",
    "test:coverage:core": "tsx scripts/run-vitest.ts coverage-core",
    "test:launch:flows": "pnpm exec vitest run src/app/api/billing/create-checkout/route.test.ts src/app/api/billing/change-plan/route.test.ts src/app/api/billing/cancel/route.test.ts src/app/api/billing/payment-status/route.test.ts src/lib/payments/checkout.test.ts src/lib/payments/fulfillment.test.ts src/lib/payments/ozow.test.ts src/__tests__/payment-cleanup-worker.test.ts src/app/api/otp/otp.test.ts src/app/verification/page.test.tsx src/__tests__/otp-send-safe-errors.test.ts src/__tests__/otp-exposure.test.ts src/__tests__/dsar-submit-route.test.ts src/__tests__/dsar-validation.test.ts src/app/api/admin/dsar/export/route.test.ts src/app/api/admin/dsar/decide/route.test.ts src/app/api/admin/dsar/complete/route.test.ts src/app/dsar/page.test.tsx && pnpm exec playwright test e2e/billing-payment-roundtrip.spec.ts e2e/dsar.spec.ts --project=chromium",
    "test:smoke": "tsx scripts/test-smoke.ts",
    "test:contract": "tsx scripts/test-contract.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test:perf": "tsx scripts/test-perf.ts",
    "test:mutation": "tsx scripts/test-mutation.ts",
    "safety:review": "tsx scripts/run-safety-gate.ts review",
    "safety:ci-review": "tsx scripts/run-safety-gate.ts ci-review",
    "safety:release": "tsx scripts/run-safety-gate.ts release",
    "check:bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "test:e2e": "playwright test",
    "test:public-verify": "tsx scripts/verify-public-pages.ts",
    "bootstrap:operator": "tsx scripts/bootstrap-operator.ts",
    "reset:launch-data": "tsx scripts/reset-launch-data.ts",
    "db:verify-schema": "tsx scripts/check-supabase-schema.ts",
    "db:check-invariants": "tsx scripts/check-db-invariants.ts",
    "preflight": "tsx scripts/check-node-version.ts && tsx scripts/preflight-check.ts",
    "preflight:prod": "tsx scripts/check-node-version.ts && tsx scripts/preflight-check.ts --mode=production",
    "preflight:prod:edge": "pnpm preflight:prod && pnpm cloudflare:secrets:check && pnpm cloudflare:posture:strict",
    "cloudflare:secrets:check": "node scripts/cloudflare-worker-secrets-check.mjs",
    "cloudflare:secrets:check:staging": "node scripts/cloudflare-worker-secrets-check.mjs --env=staging",
    "cloudflare:posture": "node scripts/cloudflare-posture-check.mjs",
    "cloudflare:posture:strict": "node scripts/cloudflare-posture-check.mjs --strict",
    "cloudflare:posture:strict:zone": "node scripts/cloudflare-posture-check.mjs --strict \"--strict-checks=Health endpoint,HSTS,DNSSEC DS record,www hostname behavior\"",
    "cloudflare:posture:json": "node scripts/cloudflare-posture-check.mjs --json",
    "cloudflare:zone:remediate": "node scripts/cloudflare-zone-remediate.mjs",
    "validate:launch-env": "tsx scripts/validate-launch-env.ts --mode=production",
    "ozow:webhook:secret": "node scripts/fetch-ozow-webhook-secret.mjs",
    "prepare": "husky",
    "generate:api-types": "openapi-typescript docs/openapi.json -o src/lib/api/v1.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1018.0",
    "@aws-sdk/s3-request-presigner": "^3.1018.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@sentry/nextjs": "^10.47.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.100.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.574.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "resend": "^6.9.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3.3.5",
    "@next/env": "16.2.1",
    "@opennextjs/cloudflare": "^1.18.0",
    "@playwright/test": "^1.58.2",
    "@storybook/react": "^10.2.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/md5": "^2.3.6",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jimp": "0.22.10",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "wrangler": "^4.77.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ],
    "overrides": {
      "tailwindcss": "3.4.19",
      "fast-xml-parser": ">=5.5.7",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  },
  "overrides": {
    "tailwindcss": "3.4.19",
    "@aws-sdk/xml-builder": "^3.972.5",
    "fast-xml-parser": ">=5.5.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm exec prettier --write",
      "pnpm exec eslint --fix --max-warnings=0"
    ],
    "*.{json,css,md}": [
      "pnpm exec prettier --write"
    ]
  }
}
