    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@sentry/nextjs": "^10.75.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.3",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "svix": "^1.92.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@ffmpeg/core": "0.12.9",
    "@next/env": "16.3.6",
    "@opennextjs/cloudflare": "^1.20.7",
    "@playwright/test": "^1.63.0",
    "@remotion/cli": "^4.0.529",
    "@storybook/react": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "jimp": "0.22.10",
    "jscpd": "^4.3.0",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.5.1",
    "only-allow": "^1.2.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "remotion": "^4.0.529",
    "supabase": "2.118.0",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ],
    "overrides": {
      "flatted@>=3.0.0 <3.4.4": "3.4.4",
      "vite@>=7.0.0 <7.3.6": "7.3.6",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "ws@>=7.0.0 <7.5.13": "7.5.13",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "undici@>=7.0.0 <7.30.0": "7.30.0",
      "browserslist@<4.28.7": "4.28.8",
      "baseline-browser-mapping@<2.11.0": "2.11.14",
      "tailwindcss": "3.4.19",
      "fast-uri": "3.1.8",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "6.1.3",
      "fast-xml-builder": "1.2.0",
      "fast-xml-parser": ">=5.7.0",
      "postcss": "8.5.23",
      "brace-expansion@^5.0.0": "5.0.12",
      "nanoid": "3.3.18",
      "next>sharp": "$sharp",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "resend>svix": "1.92.2",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@babel/core@<7.29.6": "7.29.7"
    }
  },
  "overrides": {
    "tailwindcss": "3.4.19",
    "@aws-sdk/xml-builder": "^3.972.5",
    "fast-uri": "3.1.8",
    "esbuild@>=0.27.3 <0.28.1": "0.28.1",
    "postcss-selector-parser@>=6.1.0 <6.1.3": "6.1.3",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": ">=5.7.0",
    "postcss": "$postcss",
    "brace-expansion@^5.0.0": "5.0.12",
    "nanoid": "3.3.18",
    "next": {
      "sharp": "$sharp"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm exec prettier --write",
      "pnpm exec eslint --fix --max-warnings=0"
    ],
    "*.{json,css,md}": [
      "pnpm exec prettier --write"
    ]
  }
}
