# pnpm hoisting config (required for OpenNext / africastalking compatibility)
shamefully-hoist=true
node-linker=hoisted

# Supply-chain guard: refuse to resolve package versions published less than
# 7 days ago (in minutes). Compromised releases (e.g. the Shai-Hulud npm worm)
# are usually detected and unpublished within hours. Requires pnpm >= 10.16.
minimum-release-age=10080
# The same 7-day guard for npm/npx (npm >= 11.10 reads this key, in days).
min-release-age=7

# Exact-version exemptions for security fixes newer than 7 days go here, as
# minimum-release-age-exclude[]=pkg@x.y.z. Remove each once it ages past 7 days.
# GHSA-27r3-jxmh-p828: reviewed upstream security fix (22 Oct 2026).
# Exact exception only; remove after 29 Oct 2026 11:40 UTC.
minimum-release-age-exclude[]=body-parser@2.4.0
# GHSA-w74x-v6f9-j3xg and related URI normalization fixes (19 Oct 2026).
# Exact security exception; remove after 26 Oct 2026 23:06 UTC.
minimum-release-age-exclude[]=fast-uri@3.1.9
