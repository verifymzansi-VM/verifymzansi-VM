# pnpm hoisting config (required for OpenNext / africastalking compatibility)
shamefully-hoist=true
node-linker=hoisted

# Supply-chain guard: refuse to resolve package versions published less than
# 7 days ago (in minutes). Compromised releases (e.g. the Shai-Hulud npm worm)
# are usually detected and unpublished within hours. Requires pnpm >= 10.16.
minimum-release-age=10080

# Exact-version exemptions for security fixes newer than 7 days go here, as
# minimum-release-age-exclude[]=pkg@x.y.z. Remove each once it ages past 7 days.
# GHSA (2026-10-21) @vitest/mocker <4.1.12: dev-only test tooling; 4.1.12
# published 2026-10-15 14:39-14:51 UTC. Remove after 2026-10-22 15:00 UTC.
minimum-release-age-exclude[]=vitest@4.1.12
minimum-release-age-exclude[]=@vitest/coverage-v8@4.1.12
minimum-release-age-exclude[]=@vitest/mocker@4.1.12
minimum-release-age-exclude[]=@vitest/expect@4.1.12
minimum-release-age-exclude[]=@vitest/runner@4.1.12
minimum-release-age-exclude[]=@vitest/snapshot@4.1.12
minimum-release-age-exclude[]=@vitest/spy@4.1.12
minimum-release-age-exclude[]=@vitest/utils@4.1.12
minimum-release-age-exclude[]=@vitest/pretty-format@4.1.12
